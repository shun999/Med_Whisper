    "import difflib\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# ãƒ¬ãƒ¼ãƒ™ãƒ³ã‚·ãƒ¥ã‚¿ã‚¤ãƒ³è·é›¢ï¼ˆç·¨é›†è·é›¢ï¼‰ã‚’è¨ˆç®—ã™ã‚‹é–¢æ•°\n",
    "def levenshtein_distance(s, t):\n",
    "    m, n = len(s), len(t)\n",
    "    dp = [[0]*(n+1) for _ in range(m+1)]\n",
    "    for i in range(m+1):\n",
    "        dp[i][0] = i\n",
    "    for j in range(n+1):\n",
    "        dp[0][j] = j\n",
    "    for i in range(1, m+1):\n",
    "        for j in range(1, n+1):\n",
    "            cost = 0 if s[i-1] == t[j-1] else 1\n",
    "            dp[i][j] = min(dp[i-1][j] + 1,      # å‰Šé™¤\n",
    "                           dp[i][j-1] + 1,      # æŒ¿å…¥\n",
    "                           dp[i-1][j-1] + cost) # ç½®æ›\n",
    "    return dp[m][n]\n",
    "\n",
    "# æ­£ã—ã„æ–‡ç« ã¨ Whisper ã®æ–‡å­—èµ·ã“ã—çµæœï¼ˆä¾‹ï¼‰\n",
    "correct_text = \"å‚·ç—…è€…ç™ºè¦‹ã€å‘¨å›²ã®å®‰å…¨è‰¯ã—ã€æ„ŸæŸ“é˜²å¾¡ã«é…æ…®ã—ã¾ã™\"\n",
    "transcription = \"1åˆ†å¾Œäººå½¢æŸµåœå‘¨å›²ã®å®‰å®šã‚’ã—ã€æ›ç®—å·¥å…·ã«é…æ…®ã—ã¾ã™\"\n",
    "\n",
    "# difflib ã‚’ç”¨ã„ã¦é¡ä¼¼åº¦ï¼ˆ0ã€œ1ã®å€¤ï¼‰ã‚’è¨ˆç®—\n",
    "sm = difflib.SequenceMatcher(None, correct_text, transcription)\n",
    "similarity_ratio = sm.ratio()\n",
    "\n",
    "# ãƒ¬ãƒ¼ãƒ™ãƒ³ã‚·ãƒ¥ã‚¿ã‚¤ãƒ³è·é›¢ã‚’è¨ˆç®—ã—ã€æ­£è¦åŒ–ã—ã¦ã€Œæ­£è§£ç‡ã€ã‚’ç®—å‡ºï¼ˆ1ã«è¿‘ã„ã»ã©è‰¯ã„ï¼‰\n",
    "edit_distance = levenshtein_distance(correct_text, transcription)\n",
    "normalized_accuracy = 1 - edit_distance / max(len(correct_text), len(transcription))\n",
    "\n",
    "print(\"SequenceMatcher Similarity:\", similarity_ratio)\n",
    "print(\"Edit Distance:\", edit_distance)\n",
    "print(\"Normalized Accuracy:\", normalized_accuracy)\n",
    "\n",
    "# çµæœã‚’æ£’ã‚°ãƒ©ãƒ•ã§è¡¨ç¤ºï¼ˆå€¤ã¯0ï½1ã®ç¯„å›²ï¼‰\n",
    "metrics = ['SequenceMatcher Similarity', 'Normalized Accuracy']\n",
    "values = [similarity_ratio, normalized_accuracy]\n",
    "\n",
    "plt.figure(figsize=(6,4))\n",
    "plt.bar(metrics, values, color=['skyblue', 'salmon'])\n",
    "plt.ylim(0, 1)\n",
    "plt.ylabel('Score (0ï½1)')\n",
    "plt.title('æ­£ã—ã„æ–‡ç« ã¨æ–‡å­—èµ·ã“ã—çµæœã®æ¯”è¼ƒ')\n",
    "plt.show()\n"
   ]
