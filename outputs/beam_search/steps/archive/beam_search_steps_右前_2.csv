    "from transformers import AutoTokenizer, AutoModel\n",
    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "\n",
    "# ä¾‹ã¨ã—ã¦ rinna/japanese-roberta-base ã‚’ä½¿ç”¨ï¼ˆJmedRobertaã«ç½®ãæ›ãˆã¦ãã ã•ã„ï¼‰\n",
    "model_name = \"rinna/japanese-roberta-base\"\n",
    "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
    "model = AutoModel.from_pretrained(model_name)\n",
    "\n",
    "def get_embedding(text):\n",
    "    # ãƒ†ã‚­ã‚¹ãƒˆã‚’ãƒˆãƒ¼ã‚¯ãƒ³åŒ–ã—ã€æœ€å¤§é•·ã‚’æŒ‡å®šï¼ˆå¿…è¦ã«å¿œã˜ã¦èª¿æ•´ï¼‰\n",
    "    inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=512)\n",
    "    with torch.no_grad():\n",
    "        outputs = model(**inputs)\n",
    "    # [CLS] ãƒˆãƒ¼ã‚¯ãƒ³ã®åŸ‹ã‚è¾¼ã¿ã‚’å–å¾—ï¼ˆã‚ã‚‹ã„ã¯å…¨ãƒˆãƒ¼ã‚¯ãƒ³ã®å¹³å‡ã‚’å–ã‚‹æ–¹æ³•ã‚‚ã‚ã‚Šã¾ã™ï¼‰\n",
    "    embedding = outputs.last_hidden_state[:, 0, :]\n",
    "    return embedding.squeeze().numpy()\n",
    "\n",
    "# æ­£ã—ã„æ–‡ç« ã¨ Whisper ã®æ–‡å­—èµ·ã“ã—çµæœï¼ˆä¾‹ï¼‰\n",
    "correct_text = \"å‚·ç—…è€…ç™ºè¦‹ã€å‘¨å›²ã®å®‰å…¨è‰¯ã—ã€æ„ŸæŸ“é˜²å¾¡ã«é…æ…®ã—ã¾ã™\"\n",
    "transcription = \"1åˆ†å¾Œäººå½¢æŸµåœå‘¨å›²ã®å®‰å®šã‚’ã—ã€æ›ç®—å·¥å…·ã«é…æ…®ã—ã¾ã™\"\n",
    "\n",
    "# ãã‚Œãã‚Œã®æ–‡ç« ã®åŸ‹ã‚è¾¼ã¿ã‚’å–å¾—\n",
    "embedding_correct = get_embedding(correct_text)\n",
    "embedding_transcription = get_embedding(transcription)\n",
    "\n",
    "# ã‚³ã‚µã‚¤ãƒ³é¡ä¼¼åº¦ã®è¨ˆç®—\n",
    "cos_sim = cosine_similarity([embedding_correct], [embedding_transcription])[0][0]\n",
    "print(\"Cosine Similarity (JmedRoberta):\", cos_sim)\n",
    "\n",
    "# é¡ä¼¼åº¦ã‚’æ£’ã‚°ãƒ©ãƒ•ã§è¡¨ç¤º\n",
    "metrics = ['JmedRoberta Cosine Similarity']\n",
    "values = [cos_sim]\n",
    "\n",
    "plt.figure(figsize=(4, 4))\n",
    "plt.bar(metrics, values, color=['skyblue'])\n",
    "plt.ylim(0, 1)\n",
    "plt.ylabel('Score (0ï½1)')\n",
    "plt.title('æ­£ã—ã„æ–‡ç« ã¨æ–‡å­—èµ·ã“ã—çµæœã®é¡ä¼¼åº¦')\n",
    "plt.show()\n"
   ]
  },
