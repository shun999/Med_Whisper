    "import librosa\n",
    "import numpy as np\n",
    "import soundfile as sf\n",
    "import whisper\n",
    "from scipy.signal import butter, filtfilt\n",
    "\n",
    "def high_pass_filter(audio, sr, cutoff=100, order=5):\n",
    "    nyquist = 0.5 * sr\n",
    "    normal_cutoff = cutoff / nyquist\n",
    "    b, a = butter(order, normal_cutoff, btype='high', analog=False)\n",
    "    filtered_audio = filtfilt(b, a, audio)\n",
    "    return filtered_audio\n",
    "\n",
    "def preprocess_audio(file_path, target_sr=16000):\n",
    "    # éŸ³å£°ãƒ•ã‚¡ã‚¤ãƒ«ã®èª­ã¿è¾¼ã¿ï¼ˆMOVãƒ•ã‚¡ã‚¤ãƒ«ã‚‚ ffmpeg ãŒã‚ã‚Œã°å¯¾å¿œå¯èƒ½ï¼‰\n",
    "    audio, sr = librosa.load(file_path, sr=None)\n",
    "    \n",
    "    # ã‚µãƒ³ãƒ—ãƒªãƒ³ã‚°ãƒ¬ãƒ¼ãƒˆã®èª¿æ•´ï¼ˆã‚­ãƒ¼ãƒ¯ãƒ¼ãƒ‰å¼•æ•°ã§æ¸¡ã™ï¼‰\n",
    "    if sr != target_sr:\n",
    "        audio = librosa.resample(audio, orig_sr=sr, target_sr=target_sr)\n",
    "        sr = target_sr\n",
    "    \n",
    "    # ãƒã‚¤ã‚ºé™¤å»ï¼ˆãƒã‚¤ãƒ‘ã‚¹ãƒ•ã‚£ãƒ«ã‚¿ã®é©ç”¨ï¼‰\n",
    "    audio = high_pass_filter(audio, sr, cutoff=100)\n",
    "    \n",
    "    # éŸ³é‡ã®æ­£è¦åŒ–\n",
    "    audio = librosa.util.normalize(audio)\n",
    "    \n",
    "    # å‡¦ç†æ¸ˆã¿éŸ³å£°ã®ä¿å­˜\n",
    "    output_file = \"preprocessed_audio.wav\"\n",
    "    sf.write(output_file, audio, sr)\n",
    "    \n",
    "    return output_file\n",
    "\n",
    "# å¯¾è±¡ã®éŸ³å£°ãƒ•ã‚¡ã‚¤ãƒ«ãƒ‘ã‚¹ï¼ˆMOVãƒ•ã‚¡ã‚¤ãƒ«ï¼‰\n",
    "original_file = \"/app/whisper/220data/å³å¾Œã‚_1å›ç›®.MOV\"\n",
    "\n",
    "# éŸ³å£°ãƒ•ã‚¡ã‚¤ãƒ«ã®å‰å‡¦ç†\n",
    "preprocessed_file = preprocess_audio(original_file)"
   ]
