    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import numpy as np\n",
    "from transformers import AutoTokenizer, AutoModel\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "\n",
    "# 日本語対応のRoBERTaモデルをロード（JmedRobertaに置き換えてください）\n",
    "model_name = \"rinna/japanese-roberta-base\"\n",
    "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
    "model = AutoModel.from_pretrained(model_name)\n",
    "\n",
    "def get_token_embeddings(text):\n",
    "    \"\"\"\n",
    "    テキストをトークン化し、各トークンの埋め込みを取得する関数。\n",
    "    特殊トークン（先頭、末尾）を除外して返します。\n",
    "    \"\"\"\n",
    "    inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=512)\n",
    "    with torch.no_grad():\n",
    "        outputs = model(**inputs)\n",
    "    # 出力の形状は [batch, seq_length, hidden_size]\n",
    "    token_embeddings = outputs.last_hidden_state[0]  # バッチサイズ1のため[seq_length, hidden_size]\n",
    "    tokens = tokenizer.convert_ids_to_tokens(inputs[\"input_ids\"][0])\n",
    "    # 通常、先頭と末尾は特殊トークンなので除外（モデルにより異なります）\n",
    "    token_embeddings = token_embeddings[1:-1]\n",
    "    tokens = tokens[1:-1]\n",
    "    return tokens, token_embeddings.detach().numpy()\n",
    "\n",
    "# 正しい文章と Whisper の文字起こし結果\n",
    "correct_text = \"傷病者発見、周囲の安全良し、感染防御に配慮します\"\n",
    "transcription = \"1分後人形柵圏周囲の安定をし、換算工具に配慮します\"\n",
    "\n",
    "# 各文章のトークンと埋め込みを取得\n",
    "tokens_correct, emb_correct = get_token_embeddings(correct_text)\n",
    "tokens_trans, emb_trans = get_token_embeddings(transcription)\n",
    "\n",
    "# 各トークン間のコサイン類似度を計算（正しい文章のトークンを行、認識結果のトークンを列とする）\n",
    "similarity_matrix = cosine_similarity(emb_correct, emb_trans)\n",
    "\n",
    "# ヒートマップで可視化\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.heatmap(similarity_matrix,\n",
    "            xticklabels=tokens_trans,\n",
    "            yticklabels=tokens_correct,\n",
    "            annot=True, fmt=\".2f\", cmap=\"coolwarm\")\n",
    "plt.xlabel(\"文字起こし結果のトークン\")\n",
    "plt.ylabel(\"正しい文章のトークン\")\n",
    "plt.title(\"トークンレベルのコサイン類似度\")\n",
    "plt.show()\n"
   ]
  },
