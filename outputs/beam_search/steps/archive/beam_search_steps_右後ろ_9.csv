   "source": [
    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from transformers import AutoTokenizer, AutoModel\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "\n",
    "# ‰æã„Å®„Åó„Å¶ rinna/japanese-roberta-base „Çí‰ΩøÁî®ÔºàÂøÖË¶Å„Å´Âøú„Åò„Å¶ JmedRoberta Á≠â„Å´ÁΩÆ„ÅçÊèõ„Åà„Å¶„Åè„Å†„Åï„ÅÑÔºâ\n",
    "model_name = \"rinna/japanese-roberta-base\"\n",
    "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
    "model = AutoModel.from_pretrained(model_name)\n",
    "\n",
    "def get_token_embeddings(text):\n",
    "    # „ÉÜ„Ç≠„Çπ„Éà„Çí„Éà„Éº„ÇØ„É≥Âåñ„Åó„ÉÜ„É≥„ÇΩ„É´ÂåñÔºàÊúÄÂ§ßÈï∑„ÅØÈÅ©ÂÆúË™øÊï¥Ôºâ\n",
    "    inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=512)\n",
    "    with torch.no_grad():\n",
    "        outputs = model(**inputs)\n",
    "    # ÊúÄÁµÇÂ±§„ÅÆÈö†„ÇåÁä∂ÊÖã„ÇíÂèñÂæó (shape: [1, seq_length, hidden_size])\n",
    "    embeddings = outputs.last_hidden_state.squeeze(0).numpy()  # (seq_length, hidden_size)\n",
    "    # „Éà„Éº„ÇØ„É≥ID„ÇíÊñáÂ≠óÂàó„Å´Â§âÊèõ\n",
    "    tokens = tokenizer.convert_ids_to_tokens(inputs[\"input_ids\"].squeeze(0))\n",
    "    return tokens, embeddings\n",
    "\n",
    "# Ê≠£„Åó„ÅÑÊñáÁ´†„Å® Whisper „ÅÆÊñáÂ≠óËµ∑„Åì„ÅóÁµêÊûúÔºà‰æãÔºâ\n",
    "correct_text = \"ÂÇ∑ÁóÖËÄÖÁô∫Ë¶ã„ÄÅÂë®Âõ≤„ÅÆÂÆâÂÖ®ËâØ„Åó„ÄÅÊÑüÊüìÈò≤Âæ°„Å´ÈÖçÊÖÆ„Åó„Åæ„Åô\"\n",
    "transcription = \"„Çì„Çì„Çì„Çì„Çì„Çì„Çì„ÇìÂë®Âõ≤„ÅÆÂÆâÂÆö„Çí„Åó„ÄÅÊèõÁÆóÂ∑•ÂÖ∑„Å´ÈÖçÊÖÆ„Åó„Åæ„Åô\"\n",
    "\n",
    "# ÂêÑÊñáÁ´†„ÅÆ„Éà„Éº„ÇØ„É≥„Å®Âüã„ÇÅËæº„Åø„ÇíÂèñÂæó\n",
    "tokens_correct, emb_correct = get_token_embeddings(correct_text)\n",
    "tokens_trans, emb_trans = get_token_embeddings(transcription)\n",
    "\n",
    "# ÂêÑ„Éà„Éº„ÇØ„É≥Èñì„ÅÆ„Ç≥„Çµ„Ç§„É≥È°û‰ººÂ∫¶Ë°åÂàó„ÇíË®àÁÆó\n",
    "similarity_matrix = cosine_similarity(emb_correct, emb_trans)\n",
    "print(\"Token-level cosine similarity matrix:\")\n",
    "print(similarity_matrix)\n",
    "\n",
    "# ÂÖ®‰Ωì„ÅÆÈ°û‰ººÂ∫¶„ÅØ„ÄÅÂêÑÊñáÁ´†„ÅÆÂπ≥ÂùáÂüã„ÇÅËæº„Åø„ÇíË®àÁÆó„Åó„Å¶Ê±Ç„ÇÅ„Çã\n",
    "overall_similarity = cosine_similarity(\n",
    "    emb_correct.mean(axis=0).reshape(1, -1),\n",
    "    emb_trans.mean(axis=0).reshape(1, -1)\n",
    ")[0][0]\n",
    "print(\"Overall Cosine Similarity:\", overall_similarity)\n",
    "\n",
    "# „Éí„Éº„Éà„Éû„ÉÉ„Éó„Å®„Åó„Å¶„Éó„É≠„ÉÉ„Éà\n",
    "plt.figure(figsize=(10, 8))\n",
    "plt.imshow(similarity_matrix, aspect='auto', interpolation='nearest')\n",
    "plt.colorbar(label=\"Cosine Similarity\")\n",
    "plt.xticks(ticks=np.arange(len(tokens_trans)), labels=tokens_trans, rotation=90)\n",
    "plt.yticks(ticks=np.arange(len(tokens_correct)), labels=tokens_correct)\n",
    "plt.xlabel(\"ÊñáÂ≠óËµ∑„Åì„ÅóÁµêÊûú„ÅÆ„Éà„Éº„ÇØ„É≥\")\n",
    "plt.ylabel(\"Ê≠£„Åó„ÅÑÊñáÁ´†„ÅÆ„Éà„Éº„ÇØ„É≥\")\n",
    "plt.title(\"„Éà„Éº„ÇØ„É≥„Åî„Å®„ÅÆ„Ç≥„Çµ„Ç§„É≥È°û‰ººÂ∫¶\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
