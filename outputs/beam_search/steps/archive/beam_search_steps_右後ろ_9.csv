    "def transcribe_check_for_words(wave_path, initial_prompt, correct_words):\n",
    "    # „É¢„Éá„É´„Çí‰Ωø„Å£„Å¶Èü≥Â£∞„ÇíËª¢ÂÜô\n",
    "    transcription_result = model.transcribe(\n",
    "        wave_path,\n",
    "        verbose=True,\n",
    "        language='japanese',\n",
    "        fp16=True,\n",
    "        without_timestamps=True,\n",
    "        beam_size=3,\n",
    "        initial_prompt=initial_prompt,\n",
    "    )\n",
    "    # Ëª¢ÂÜôÁµêÊûú„Åã„Çâ„ÉÜ„Ç≠„Çπ„Éà„ÇíÂèñÂæó\n",
    "    transcribed_text = transcription_result['text']  \n",
    "\n",
    "    def word_present(transcribed_text, word):\n",
    "        return word in transcribed_text\n",
    "\n",
    "\n",
    "    # Ê≠£„Åó„ÅÑÂçòË™û„ÅåÂê´„Åæ„Çå„Å¶„ÅÑ„Çã„Åã„Å©„ÅÜ„Åã„ÇíÂà§ÂÆö\n",
    "    for word in correct_words:\n",
    "        if word_present(transcribed_text, word):\n",
    "            print(f\"'{word}' OK\")\n",
    "        else:\n",
    "            print(f\"'{word}' NG\")\n",
    "\n",
    "wave_path ='/app/whisper/220data/Âè≥Ââç_1ÂõûÁõÆ.mov'#ArithmeticError\n",
    "initial_prompt ='Âë®Âõ≤ ÊÑüÊüìÈò≤Âæ° „Å†„ÅÑ„Åò„Çá„ÅÜ„Å∂„Åß„Åô„Åã 1 2 3 È†∏ÂãïËÑà ÂëºÂê∏„ÅÆÁ¢∫Ë™ç ËÑà„ÅÆÁ¢∫Ë™ç ËòáÁîü'\n",
    "correct_words = ['ÂÇ∑ÁóÖËÄÖ', 'Âë®Âõ≤', 'ÊÑüÊüìÈò≤Âæ°', 'Â§ß‰∏àÂ§´„Åß„Åô„Åã', 'Ë™∞„ÅãÊù•„Å¶„Åè„Å†„Åï„ÅÑ', '1 2 3','119Áï™', 'AED„ÇíÊåÅ„Å£„Å¶„Åç„Å¶„Åè„Å†„Åï„ÅÑ', 'ÂëºÂê∏„ÅÆÁ¢∫Ë™ç', 'ËÑà„ÅÆÁ¢∫Ë™ç', 'Ëç∑Áâ©']\n",
    "\n",
    "transcribe_check_for_words(wave_path,initial_prompt,correct_words)"
   ]
