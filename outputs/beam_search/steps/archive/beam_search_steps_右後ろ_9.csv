   "source": [
    "import difflib\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# „É¨„Éº„Éô„É≥„Ç∑„É•„Çø„Ç§„É≥Ë∑ùÈõ¢ÔºàÁ∑®ÈõÜË∑ùÈõ¢Ôºâ„ÇíË®àÁÆó„Åô„ÇãÈñ¢Êï∞\n",
    "def levenshtein_distance(s, t):\n",
    "    m, n = len(s), len(t)\n",
    "    dp = [[0]*(n+1) for _ in range(m+1)]\n",
    "    for i in range(m+1):\n",
    "        dp[i][0] = i\n",
    "    for j in range(n+1):\n",
    "        dp[0][j] = j\n",
    "    for i in range(1, m+1):\n",
    "        for j in range(1, n+1):\n",
    "            cost = 0 if s[i-1] == t[j-1] else 1\n",
    "            dp[i][j] = min(dp[i-1][j] + 1,      # ÂâäÈô§\n",
    "                           dp[i][j-1] + 1,      # ÊåøÂÖ•\n",
    "                           dp[i-1][j-1] + cost) # ÁΩÆÊèõ\n",
    "    return dp[m][n]\n",
    "\n",
    "# Ê≠£„Åó„ÅÑÊñáÁ´†„Å® Whisper „ÅÆÊñáÂ≠óËµ∑„Åì„ÅóÁµêÊûúÔºà‰æãÔºâ\n",
    "correct_text = \"ÂÇ∑ÁóÖËÄÖÁô∫Ë¶ã„ÄÅÂë®Âõ≤„ÅÆÂÆâÂÖ®ËâØ„Åó„ÄÅÊÑüÊüìÈò≤Âæ°„Å´ÈÖçÊÖÆ„Åó„Åæ„Åô\"\n",
    "transcription = \"1ÂàÜÂæå‰∫∫ÂΩ¢ÊüµÂúèÂë®Âõ≤„ÅÆÂÆâÂÆö„Çí„Åó„ÄÅÊèõÁÆóÂ∑•ÂÖ∑„Å´ÈÖçÊÖÆ„Åó„Åæ„Åô\"\n",
    "\n",
    "# difflib „ÇíÁî®„ÅÑ„Å¶È°û‰ººÂ∫¶Ôºà0„Äú1„ÅÆÂÄ§Ôºâ„ÇíË®àÁÆó\n",
    "sm = difflib.SequenceMatcher(None, correct_text, transcription)\n",
    "similarity_ratio = sm.ratio()\n",
    "\n",
    "# „É¨„Éº„Éô„É≥„Ç∑„É•„Çø„Ç§„É≥Ë∑ùÈõ¢„ÇíË®àÁÆó„Åó„ÄÅÊ≠£Ë¶èÂåñ„Åó„Å¶„ÄåÊ≠£Ëß£Áéá„Äç„ÇíÁÆóÂá∫Ôºà1„Å´Ëøë„ÅÑ„Åª„Å©ËâØ„ÅÑÔºâ\n",
    "edit_distance = levenshtein_distance(correct_text, transcription)\n",
    "normalized_accuracy = 1 - edit_distance / max(len(correct_text), len(transcription))\n",
    "\n",
    "print(\"SequenceMatcher Similarity:\", similarity_ratio)\n",
    "print(\"Edit Distance:\", edit_distance)\n",
    "print(\"Normalized Accuracy:\", normalized_accuracy)\n",
    "\n",
    "# ÁµêÊûú„ÇíÊ£í„Ç∞„É©„Éï„ÅßË°®Á§∫ÔºàÂÄ§„ÅØ0ÔΩû1„ÅÆÁØÑÂõ≤Ôºâ\n",
    "metrics = ['SequenceMatcher Similarity', 'Normalized Accuracy']\n",
    "values = [similarity_ratio, normalized_accuracy]\n",
    "\n",
    "plt.figure(figsize=(6,4))\n",
    "plt.bar(metrics, values, color=['skyblue', 'salmon'])\n",
    "plt.ylim(0, 1)\n",
    "plt.ylabel('Score (0ÔΩû1)')\n",
    "plt.title('Ê≠£„Åó„ÅÑÊñáÁ´†„Å®ÊñáÂ≠óËµ∑„Åì„ÅóÁµêÊûú„ÅÆÊØîËºÉ')\n",
    "plt.show()\n"
   ]
  },
