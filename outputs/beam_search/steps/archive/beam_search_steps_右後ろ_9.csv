    "from transformers import AutoTokenizer, AutoModel\n",
    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "\n",
    "# ‰æã„Å®„Åó„Å¶ rinna/japanese-roberta-base „Çí‰ΩøÁî®ÔºàJmedRoberta„Å´ÁΩÆ„ÅçÊèõ„Åà„Å¶„Åè„Å†„Åï„ÅÑÔºâ\n",
    "model_name = \"alabnii/jmedroberta-base-sentencepiece\"\n",
    "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
    "model = AutoModel.from_pretrained(model_name)\n",
    "\n",
    "def get_embedding(text):\n",
    "    # „ÉÜ„Ç≠„Çπ„Éà„Çí„Éà„Éº„ÇØ„É≥Âåñ„Åó„ÄÅÊúÄÂ§ßÈï∑„ÇíÊåáÂÆöÔºàÂøÖË¶Å„Å´Âøú„Åò„Å¶Ë™øÊï¥Ôºâ\n",
    "    inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=512)\n",
    "    with torch.no_grad():\n",
    "        outputs = model(**inputs)\n",
    "    # [CLS] „Éà„Éº„ÇØ„É≥„ÅÆÂüã„ÇÅËæº„Åø„ÇíÂèñÂæóÔºà„ÅÇ„Çã„ÅÑ„ÅØÂÖ®„Éà„Éº„ÇØ„É≥„ÅÆÂπ≥Âùá„ÇíÂèñ„ÇãÊñπÊ≥ï„ÇÇ„ÅÇ„Çä„Åæ„ÅôÔºâ\n",
    "    embedding = outputs.last_hidden_state[:, 0, :]\n",
    "    return embedding.squeeze().numpy()\n",
    "\n",
    "# Ê≠£„Åó„ÅÑÊñáÁ´†„Å® Whisper „ÅÆÊñáÂ≠óËµ∑„Åì„ÅóÁµêÊûúÔºà‰æãÔºâ\n",
    "correct_text = \"ÂÇ∑ÁóÖËÄÖÁô∫Ë¶ã„ÄÅÂë®Âõ≤„ÅÆÂÆâÂÖ®ËâØ„Åó„ÄÅÊÑüÊüìÈò≤Âæ°„Å´ÈÖçÊÖÆ„Åó„Åæ„Åô\"\n",
    "transcription = \"1ÂàÜÂæå‰∫∫ÂΩ¢ÊüµÂúèÂë®Âõ≤„ÅÆÂÆâÂÆö„Çí„Åó„ÄÅÊèõÁÆóÂ∑•ÂÖ∑„Å´ÈÖçÊÖÆ„Åó„Åæ„Åô\"\n",
    "\n",
    "\n",
    "# „Åù„Çå„Åû„Çå„ÅÆÊñáÁ´†„ÅÆÂüã„ÇÅËæº„Åø„ÇíÂèñÂæó\n",
    "embedding_correct = get_embedding(correct_text)\n",
    "embedding_transcription = get_embedding(transcription)\n",
    "\n",
    "# „Ç≥„Çµ„Ç§„É≥È°û‰ººÂ∫¶„ÅÆË®àÁÆó\n",
    "cos_sim = cosine_similarity([embedding_correct], [embedding_transcription])[0][0]\n",
    "print(\"Cosine Similarity (JmedRoberta):\", cos_sim)\n",
    "\n",
    "# È°û‰ººÂ∫¶„ÇíÊ£í„Ç∞„É©„Éï„ÅßË°®Á§∫\n",
    "metrics = ['JmedRoberta Cosine Similarity']\n",
    "values = [cos_sim]\n",
    "\n",
    "plt.figure(figsize=(4, 4))\n",
    "plt.bar(metrics, values, color=['skyblue'])\n",
    "plt.ylim(0, 1)\n",
    "plt.ylabel('Score (0ÔΩû1)')\n",
    "plt.title('Ê≠£„Åó„ÅÑÊñáÁ´†„Å®ÊñáÂ≠óËµ∑„Åì„ÅóÁµêÊûú„ÅÆÈ°û‰ººÂ∫¶')\n",
    "plt.show()\n"
   ]
  },
