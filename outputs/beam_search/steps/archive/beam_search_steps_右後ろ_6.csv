    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from transformers import AutoTokenizer, AutoModel\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "\n",
    "# ä¾‹ã¨ã—ã¦ rinna/japanese-roberta-base ã‚’ä½¿ç”¨ï¼ˆJmedRobertaç­‰ã«ç½®ãæ›ãˆå¯èƒ½ï¼‰\n",
    "model_name = \"rinna/japanese-roberta-base\"\n",
    "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
    "model = AutoModel.from_pretrained(model_name)\n",
    "\n",
    "def get_token_embeddings(text):\n",
    "    # ãƒ†ã‚­ã‚¹ãƒˆã‚’ãƒˆãƒ¼ã‚¯ãƒ³åŒ–ã—ã€ãƒ†ãƒ³ã‚½ãƒ«ã«å¤‰æ›ï¼ˆé•·ã•ã®ä¸Šé™ã¯å¿…è¦ã«å¿œã˜ã¦èª¿æ•´ï¼‰\n",
    "    inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=512)\n",
    "    with torch.no_grad():\n",
    "        outputs = model(**inputs)\n",
    "    # æœ€çµ‚å±¤ã®éš ã‚ŒçŠ¶æ…‹ï¼ˆå½¢çŠ¶: [1, seq_length, hidden_size]ï¼‰ã‚’å–å¾—\n",
    "    embeddings = outputs.last_hidden_state.squeeze(0).numpy()  # (seq_length, hidden_size)\n",
    "    # ãƒˆãƒ¼ã‚¯ãƒ³IDã‚’æ–‡å­—åˆ—ã«å¤‰æ›\n",
    "    tokens = tokenizer.convert_ids_to_tokens(inputs[\"input_ids\"].squeeze(0))\n",
    "    return tokens, embeddings\n",
    "\n",
    "# æ­£ã—ã„æ–‡ç« ã¨ Whisper ã®æ–‡å­—èµ·ã“ã—çµæžœï¼ˆä¾‹ï¼‰\n",
    "correct_text = \"å‚·ç—…è€…ç™ºè¦‹ã€å‘¨å›²ã®å®‰å…¨è‰¯ã—ã€æ„ŸæŸ“é˜²å¾¡ã«é…æ…®ã—ã¾ã™\"\n",
    "transcription = \"å‚·ç—…è€…ç™ºè¦‹ã€å‘¨å›²ã®å®‰å…¨è‰¯ã—ã€æ„ŸæŸ“é˜²å¾¡ã«é…æ…®ã—ã¾ã™\"\n",
    "\n",
    "# å„æ–‡ç« ã®ãƒˆãƒ¼ã‚¯ãƒ³ã¨åŸ‹ã‚è¾¼ã¿ã‚’å–å¾—\n",
    "tokens_correct, emb_correct = get_token_embeddings(correct_text)\n",
    "tokens_trans, emb_trans = get_token_embeddings(transcription)\n",
    "\n",
    "# ãƒˆãƒ¼ã‚¯ãƒ³é–“ã®ã‚³ã‚µã‚¤ãƒ³é¡žä¼¼åº¦è¡Œåˆ—ã‚’è¨ˆç®—\n",
    "similarity_matrix = cosine_similarity(emb_correct, emb_trans)\n",
    "\n",
    "# ãƒ’ãƒ¼ãƒˆãƒžãƒƒãƒ—ã¨ã—ã¦ãƒ—ãƒ­ãƒƒãƒˆ\n",
    "plt.figure(figsize=(10, 8))\n",
    "plt.imshow(similarity_matrix, aspect='auto', interpolation='nearest')\n",
    "plt.colorbar(label=\"Cosine Similarity\")\n",
    "plt.xticks(ticks=np.arange(len(tokens_trans)), labels=tokens_trans, rotation=90)\n",
    "plt.yticks(ticks=np.arange(len(tokens_correct)), labels=tokens_correct)\n",
    "plt.xlabel(\"æ–‡å­—èµ·ã“ã—çµæžœã®ãƒˆãƒ¼ã‚¯ãƒ³\")\n",
    "plt.ylabel(\"æ­£ã—ã„æ–‡ç« ã®ãƒˆãƒ¼ã‚¯ãƒ³\")\n",
    "plt.title(\"ãƒˆãƒ¼ã‚¯ãƒ³ã”ã¨ã®ã‚³ã‚µã‚¤ãƒ³é¡žä¼¼åº¦\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
