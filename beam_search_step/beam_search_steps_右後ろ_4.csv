   "source": [
    "#tokens_list のネストを解除する\n",
    "import itertools\n",
    "\n",
    "#Whisper の文字起こし結果から tokens を取得\n",
    "tokens_list = [segment[\"tokens\"] for segment in result_beam[\"segments\"]]\n",
    "\n",
    "# ネストを解除\n",
    "flat_tokens = list(itertools.chain.from_iterable(tokens_list))\n",
    "\n",
    "# 出力\n",
    "flat_tokens\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "correct_words = [\"安全\", '傷病者発見', '感染防御', '大丈夫ですか', '誰か来てください', '119番', 'AED', '呼吸の確認', \"脈の確認\", \"1 2 3\", 'ショック', '荷物']\n",
    "\n",
    "# result_beamからテキストを取得\n",
    "text = result_beam['text']\n",
    "\n",
    "# 各単語がテキストに含まれているかを確認\n",
    "word_presence = {word: word in text for word in correct_words}\n",
    "\n",
    "# 結果を表示\n",
    "df = pd.DataFrame(list(word_presence.items()), columns=['Word', 'Presence'])\n",
    "df"
   ]
  },
  {
   "cell_type": "code",
