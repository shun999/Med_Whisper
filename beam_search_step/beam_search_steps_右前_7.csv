    "def transcribe_check_for_words(wave_path, initial_prompt, correct_words):\n",
    "    # ãƒ¢ãƒ‡ãƒ«ã‚’ä½¿ã£ã¦éŸ³å£°ã‚’è»¢å†™\n",
    "    transcription_result = model.transcribe(\n",
    "        wave_path,\n",
    "        verbose=True,\n",
    "        language='japanese',\n",
    "        fp16=True,\n",
    "        without_timestamps=True,\n",
    "        beam_size=3,\n",
    "        initial_prompt=initial_prompt,\n",
    "    )\n",
    "    # è»¢å†™çµæžœã‹ã‚‰ãƒ†ã‚­ã‚¹ãƒˆã‚’å–å¾—\n",
    "    transcribed_text = transcription_result['text']  \n",
    "\n",
    "    def word_present(transcribed_text, word):\n",
    "        return word in transcribed_text\n",
    "\n",
    "\n",
    "    # æ­£ã—ã„å˜èªžãŒå«ã¾ã‚Œã¦ã„ã‚‹ã‹ã©ã†ã‹ã‚’åˆ¤å®š\n",
    "    for word in correct_words:\n",
    "        if word_present(transcribed_text, word):\n",
    "            print(f\"'{word}' OK\")\n",
    "        else:\n",
    "            print(f\"'{word}' NG\")\n",
    "\n",
    "wave_path ='/app/whisper/220data/å³å‰_1å›žç›®.mov'#ArithmeticError\n",
    "initial_prompt ='å‘¨å›² æ„ŸæŸ“é˜²å¾¡ ã ã„ã˜ã‚‡ã†ã¶ã§ã™ã‹ 1 2 3 é ¸å‹•è„ˆ å‘¼å¸ã®ç¢ºèª è„ˆã®ç¢ºèª è˜‡ç”Ÿ'\n",
    "correct_words = ['å‚·ç—…è€…', 'å‘¨å›²', 'æ„ŸæŸ“é˜²å¾¡', 'å¤§ä¸ˆå¤«ã§ã™ã‹', 'èª°ã‹æ¥ã¦ãã ã•ã„', '1 2 3','119ç•ª', 'AEDã‚’æŒã£ã¦ãã¦ãã ã•ã„', 'å‘¼å¸ã®ç¢ºèª', 'è„ˆã®ç¢ºèª', 'è·ç‰©']\n",
    "\n",
    "transcribe_check_for_words(wave_path,initial_prompt,correct_words)"
