   "source": [
    "#tokens_list のネストを解除する\n",
    "import itertools\n",
    "\n",
    "#Whisper の文字起こし結果から tokens を取得\n",
    "tokens_list = [segment[\"tokens\"] for segment in result_beam[\"segments\"]]\n",
    "\n",
    "# ネストを解除\n",
    "flat_tokens = list(itertools.chain.from_iterable(tokens_list))\n",
    "\n",
    "# 出力\n",
    "flat_tokens\n"
   ]
