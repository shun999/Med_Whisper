    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "import japanize_matplotlib\n",
    "import seaborn as sns\n",
    "import numpy as np\n",
    "from transformers import AutoTokenizer, AutoModel\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "\n",
    "# æ—¥æœ¬èªžå¯¾å¿œã®RoBERTaãƒ¢ãƒ‡ãƒ«ã‚’ãƒ­ãƒ¼ãƒ‰ï¼ˆJmedRobertaã«ç½®ãæ›ãˆã¦ãã ã•ã„ï¼‰\n",
    "model_name = \"rinna/japanese-roberta-base\"\n",
    "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
    "model = AutoModel.from_pretrained(model_name)\n",
    "\n",
    "def get_token_embeddings(text):\n",
    "    \"\"\"\n",
    "    ãƒ†ã‚­ã‚¹ãƒˆã‚’ãƒˆãƒ¼ã‚¯ãƒ³åŒ–ã—ã€å„ãƒˆãƒ¼ã‚¯ãƒ³ã®åŸ‹ã‚è¾¼ã¿ã‚’å–å¾—ã™ã‚‹é–¢æ•°ã€‚\n",
    "    ç‰¹æ®Šãƒˆãƒ¼ã‚¯ãƒ³ï¼ˆå…ˆé ­ã€æœ«å°¾ï¼‰ã‚’é™¤å¤–ã—ã¦è¿”ã—ã¾ã™ã€‚\n",
    "    \"\"\"\n",
    "    inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=512)\n",
    "    with torch.no_grad():\n",
    "        outputs = model(**inputs)\n",
    "    # å‡ºåŠ›ã®å½¢çŠ¶ã¯ [batch, seq_length, hidden_size]\n",
    "    token_embeddings = outputs.last_hidden_state[0]  # ãƒãƒƒãƒã‚µã‚¤ã‚º1ã®ãŸã‚[seq_length, hidden_size]\n",
    "    tokens = tokenizer.convert_ids_to_tokens(inputs[\"input_ids\"][0])\n",
    "    # é€šå¸¸ã€å…ˆé ­ã¨æœ«å°¾ã¯ç‰¹æ®Šãƒˆãƒ¼ã‚¯ãƒ³ãªã®ã§é™¤å¤–ï¼ˆãƒ¢ãƒ‡ãƒ«ã«ã‚ˆã‚Šç•°ãªã‚Šã¾ã™ï¼‰\n",
    "    token_embeddings = token_embeddings[1:-1]\n",
    "    tokens = tokens[1:-1]\n",
    "    return tokens, token_embeddings.detach().numpy()\n",
    "\n",
    "# æ­£ã—ã„æ–‡ç« ã¨ Whisper ã®æ–‡å­—èµ·ã“ã—çµæžœ\n",
    "correct_text = \"å‚·ç—…è€…ç™ºè¦‹å‘¨å›²ã®å®‰å…¨è‰¯ã—æ„ŸæŸ“é˜²å¾¡ã«é…æ…®ã—ã¾ã™\"\n",
    "transcription = \"1åˆ†å¾Œäººå½¢æŸµåœå‘¨å›²ã®å®‰å®šã‚’ã—æ›ç®—å·¥å…·ã«é…æ…®ã—ã¾ã™\"\n",
    "\n",
    "# å„æ–‡ç« ã®ãƒˆãƒ¼ã‚¯ãƒ³ã¨åŸ‹ã‚è¾¼ã¿ã‚’å–å¾—\n",
    "tokens_correct, emb_correct = get_token_embeddings(correct_text)\n",
    "tokens_trans, emb_trans = get_token_embeddings(transcription)\n",
    "\n",
    "# å„ãƒˆãƒ¼ã‚¯ãƒ³é–“ã®ã‚³ã‚µã‚¤ãƒ³é¡žä¼¼åº¦ã‚’è¨ˆç®—ï¼ˆæ­£ã—ã„æ–‡ç« ã®ãƒˆãƒ¼ã‚¯ãƒ³ã‚’è¡Œã€èªè­˜çµæžœã®ãƒˆãƒ¼ã‚¯ãƒ³ã‚’åˆ—ã¨ã™ã‚‹ï¼‰\n",
    "similarity_matrix = cosine_similarity(emb_correct, emb_trans)\n",
    "print(\"Cosine Similarity (JmedRoberta):\", cos_sim)\n",
    "# ãƒ’ãƒ¼ãƒˆãƒžãƒƒãƒ—ã§å¯è¦–åŒ–\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.heatmap(similarity_matrix,\n",
    "            xticklabels=tokens_trans,\n",
    "            yticklabels=tokens_correct,\n",
    "            annot=True, fmt=\".2f\", cmap=\"coolwarm\")\n",
    "plt.xlabel(\"æ–‡å­—èµ·ã“ã—çµæžœã®ãƒˆãƒ¼ã‚¯ãƒ³\")\n",
